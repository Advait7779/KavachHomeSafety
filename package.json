    "vite": "^8.3.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "framer-motion": "^12.4.7",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "zod": "^4.6.7"
  }
