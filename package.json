{
  "name": "kavachhomesafety",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env.local --watch server/index.js",
    "start": "npm run start:api",
    "start:api": "node --env-file-if-exists=.env.local server/index.js",
    "test:api": "npm run build && node server/smoke-test.js",
